# redcat2 .env — copy to .env and fill in. LF line endings only (a stray CR corrupts tokens).
# redcat2 is standalone: this is the only env it reads. No sibling project is sourced.

# Claude Code subscription token (run: claude setup-token). Required.
CLAUDE_CODE_OAUTH_TOKEN=

# HTB labs web-app token (aud:6), grabbed from a logged-in browser HAR. Enables name
# resolution, auto-spawn, and flag auto-submit. Optional — ./hunt <ip> works without it.
# When the token is missing/expired, ./hunt auto-imports the newest *.har from HAR_SRC into
# har/ and extracts a fresh token into this file. Just keep dropping DevTools HARs in HAR_SRC.
HTB_TOKEN=

# Folder where you save HTB DevTools HAR exports (newest wins). Default is the Windows path below.
# HAR_SRC=/mnt/c/Users/Godjs/Desktop/tmp/htb-api-har

# Path to SecLists (defaults to ~/files_etc/SecLists if unset).
SECLISTS_DIR=

# Enables `sudo -A` for apt/openvpn/hosts without a TTY prompt. Optional.
SUDO_PASS=

# OpenVPN config for the HTB tunnel; ./hunt auto-connects if the target isn't routed. Optional.
HTB_OVPN=

# Burp MCP token (from BurpMCP-Ultra's Server tab) — only needed if you wire Burp in later. Optional.
BURP_MCP_TOKEN=
