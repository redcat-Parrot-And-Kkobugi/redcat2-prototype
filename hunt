#!/usr/bin/env bash
# =============================================================================
#  hunt — redcat2 launcher. Give it any HTB machine name or IP (Easy through
#  Insane) and it runs an autonomous research hunt (Claude Code headless) until
#  user.txt + root.txt. Needs the newest HAR in har/ only when the token is stale.
#
#    ./hunt <machine_name|ip> [orchestrator_model] [extra notes]
#      ./hunt Blizzard                 # name -> HTB API resolves/spawns, Opus 4.8 orchestrator
#      ./hunt 10.10.11.42 opus "the web app on 443 looks custom"
#      ./hunt Blizzard sonnet          # cheaper orchestrator
#
#  Resume is automatic: re-launch the same target and it reads the run dir's
#  worldmodel.md / hypotheses.md / journal.md and continues (memory lives on disk).
#
#  Authorized labs only. Runs with --dangerously-skip-permissions: Claude executes
#  shell commands without asking. Only ever point it at a host you may test.
# =============================================================================
set -euo pipefail

# flags: --fresh (archive existing run, start clean). Everything else is positional.
ARGS=()
for a in "$@"; do
  case "$a" in
    --fresh) export FRESH=1 ;;
    *)       ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]}"

TARGET="${1:?usage: hunt [--fresh] <machine_name|ip> [model] [notes]}"
MODEL="${2:-claude-opus-4-8}" # orchestrator model (default: Opus 4.8). Insane wants the strongest. Sub-agents pick their own.
NOTES="${3:-}"
MAX_RESTARTS="${MAX_RESTARTS:-20}"   # auto-relaunch budget on crash/overflow (NO_RESTART=1 to disable)

RC2_ROOT="$(cd "$(dirname "$0")" && pwd)"
. "$RC2_ROOT/lib/bootstrap.sh"

rc2_load_env
# Pin the orchestrator to the 4.8 generation. A bare alias (opus/sonnet/haiku) or a Claude-5 id trips
# the real-time cyber safeguard harder than 4.8, and every sub-agent + judge is already pinned there —
# so keep one consistent generation. Explicit claude-*-4-* passes through; RC2_NO_PIN=1 opts out.
_req_model="$MODEL"; MODEL="$(rc2_pin_model "$MODEL")"
[ "$MODEL" != "$_req_model" ] && echo "[model] orchestrator '$_req_model' -> pinned $MODEL (RC2_NO_PIN=1 to override)"
rc2_ensure_htb_token || true          # HAR -> live token (name targets need it; IP targets continue without)
rc2_resolve_target "$TARGET"
RUNDIR="$(rc2_scaffold)"
. "$RUNDIR/target.env"
: "${target_ip:?target_ip empty — set it in $RUNDIR/target.env and re-run}"
rc2_rotate_journal "$RUNDIR"          # roll old journal entries to archive BEFORE launch (bounds each resume's re-hydration)

# ── per-launch run-state reset (must run BEFORE any watcher starts) ───────────
# A prior run's cleanup left logs/.stop as its "this run is over" flag; it is NOT cleared on scaffold, so
# on a RESUME every `while [ ! -f .stop ]` watcher (flag-submit, guard/sameness-judge, status, target-
# health) would see the stale flag at its first check and exit at t=0 — silently disabling live flag
# submission, the rabbit-hole guard, and the health signal. Clear it so .stop means THIS run.
rm -f "$RUNDIR/logs/.stop"
# stale auditor push-state from a prior run would make the hook re-nudge (or block) on a tick the solver
# already handled — clear it so the push reflects THIS run's auditor only. auditor.md itself is living
# memory (kept); only the hook's per-run ack/nudge counter is reset.
rm -f "$RUNDIR/logs/.auditor_nudge"
# accounting.json is seeded only once (resume preserves it), so the operator's launch-env RC2_CEIL/RC2_WARN
# would be ignored on a re-launch — the hook reads .global.ceiling/.warn_at from the file, not the env.
# Re-apply them each launch so an operator override takes effect on resume too.
if [ -s "$RUNDIR/logs/accounting.json" ]; then
  jq --argjson c "${RC2_CEIL:-800}" --argjson w "${RC2_WARN:-450}" '.global.ceiling=$c | .global.warn_at=$w' \
     "$RUNDIR/logs/accounting.json" > "$RUNDIR/logs/accounting.json.tmp" 2>/dev/null \
     && mv "$RUNDIR/logs/accounting.json.tmp" "$RUNDIR/logs/accounting.json" 2>/dev/null \
     || rm -f "$RUNDIR/logs/accounting.json.tmp" 2>/dev/null
fi

export TMPDIR="$RUNDIR/tmp"; mkdir -p "$TMPDIR"
# Relaunch efficiency comes from SERVER-SIDE prompt caching (TTL in lib/env.sh), not a local cache —
# Claude keeps no local prompt cache. runs/<slug>/cache/ exists for run-local scratch only; we do NOT
# point Claude's config/cache into it, because relocating CLAUDE_CONFIG_DIR would move user-scope MCP
# (burp, and the ida-pro-mcp that `reverser` uses) and break them. (XDG_CACHE_HOME is unsupported here.)

# Non-interactive sudo via askpass (so `sudo -A` never hangs and the password is never on a cmd line).
if [ -n "${SUDO_PASS:-}" ]; then
  export SUDO_PASS
  ASKPASS="$TMPDIR/.askpass"; printf '#!/bin/sh\nprintf "%%s\\n" "$SUDO_PASS"\n' > "$ASKPASS"; chmod 700 "$ASKPASS"
  export SUDO_ASKPASS="$ASKPASS"; SUDO_A="sudo -A"
else
  SUDO_A="sudo -n"
fi

rc2_ensure_vpn "$target_ip" "$SUDO_A"

# shared tmux session for long/interactive tools (watchable live: tmux attach -t <tmux_base>_main)
export RC2_TMUX="${tmux_base}_main"
tmux new-session -d -s "$RC2_TMUX" -x 220 -y 50 2>/dev/null || true

# flag submission mode: read HTB owned-status now; pre-mark already-owned flags, else defer to end
rc2_htb_owned_init "$RUNDIR"
# background flag auto-submitter (returns immediately in IP-only mode)
rc2_flag_watcher "$RUNDIR" & FLAG_WATCH_PID=$!
# background status snapshotter: rewrites status.md every STATUS_INTERVAL (default 600s)
rc2_status_writer "$RUNDIR" & STATUS_PID=$!
# background target-health watcher: flips target_health.md UP/DOWN so the agent learns the box rebooted
# under it (HTB auto-reset/respawn/crash) instead of misreading failing commands as a broken exploit
HEALTH_PID=""
[ "${NO_HEALTH:-0}" != "1" ] && { rc2_health_watcher "$RUNDIR" & HEALTH_PID=$!; }
# background sameness-judge watcher (P1-d): an independent judge freezes a hypothesis ruled a rabbit
# hole. Runs when enforcement is enabled (RC2_GUARD!=off) or RC2_GUARD_WATCH=1 or RC2_GATE=1; NO_GUARD_WATCH=1 forces off.
# R5 (intentional): this predicate is deliberately WIDER than oversee's gate predicate — RC2_GUARD is the
# operator's minimum FLOOR, RC2_GUARD_WATCH is judge-only (freeze, no live gate), RC2_GATE enables oversee's
# LIVE escalation. The watcher should run whenever ANY of those automation layers is active.
GUARD_WATCH_PID=""
if { rc2_guard_core_on || [ "${RC2_GUARD_WATCH:-0}" = "1" ]; } && [ "${NO_GUARD_WATCH:-0}" != "1" ]; then
  rc2_guard_watcher "$RUNDIR" & GUARD_WATCH_PID=$!
  echo "[guard] sameness watcher on (judge=${GUARD_JUDGE_MODEL:-sonnet}, every ${GUARD_WATCH_INTERVAL:-180}s, stall=${RC2_STALL:-12})"
fi

# supervisor/critic alongside the hunt in a <tmux_base>_oversee tmux session. It reads the logs +
# living files and writes supervisor.md on drift.
rc2_launch_oversee "$RUNDIR"
# epistemic auditor alongside the hunt (same placement policy as oversee): a periodic independent opus
# reader of the raw logs that catches a vector abandoned on INCONCLUSIVE evidence and pushes the solver
# (via the hook) to re-open it. Complements oversee (strategy) by auditing evidence quality. NO_AUDITOR=1 skips.
rc2_launch_auditor "$RUNDIR"

cleanup() {
  [ -n "${_CLEANED:-}" ] && return 0; _CLEANED=1
  [ -n "${RUN_PID:-}" ] && { pkill -TERM -P "$RUN_PID" 2>/dev/null || true; kill -TERM "$RUN_PID" 2>/dev/null || true; }
  touch "$RUNDIR/logs/.stop" 2>/dev/null || true
  rc2_flag_scan_once "$RUNDIR" final 2>/dev/null || true           # final sweep: submit (incl. the deferred-mode batch) any captured flag
  [ -n "${FLAG_WATCH_PID:-}" ] && kill "$FLAG_WATCH_PID" 2>/dev/null || true
  [ -n "${STATUS_PID:-}" ] && kill "$STATUS_PID" 2>/dev/null || true
  [ -n "${HEALTH_PID:-}" ] && kill "$HEALTH_PID" 2>/dev/null || true
  [ -n "${GUARD_WATCH_PID:-}" ] && kill "$GUARD_WATCH_PID" 2>/dev/null || true
  rc2_write_status "$RUNDIR" 2>/dev/null || true                   # final snapshot
  rc2_stop_oversee || true                                         # stop supervisor (tmux session)
  rc2_stop_auditor || true                                         # stop epistemic auditor (tmux session)
  # retrospective: metrics → writeup.md, and a failure classification (both best-effort)
  "$RC2_ROOT/scripts/report.sh"      "$RUNDIR" 2>/dev/null || true
  "$RC2_ROOT/scripts/analyze_run.sh" "$RUNDIR" 2>/dev/null || true
  # SOLVED = both flags present AND (API mode) both ACCEPTED by the lab — only then stop the HTB machine
  # + tear down tmux. A captured-but-rejected/stale flag is NOT solved, so the box is kept for resume.
  if rc2_solved "$RUNDIR"; then
    if [ "${RC2_HTB:-0}" = "1" ] && [ -n "${machine_id:-}" ] && [ "${NO_STOP:-0}" != "1" ]; then
      if htb_terminate "$machine_id" >/dev/null 2>&1; then echo "[hunt] HTB machine terminated (id $machine_id)."
      else echo "[hunt] HTB terminate request sent (id $machine_id) — verify with scripts/machine.sh active."; fi
    fi
    tmux ls -F '#{session_name}' 2>/dev/null | grep -E "^${tmux_base}(_|$)" | while read -r s; do tmux kill-session -t "$s" 2>/dev/null || true; done
    echo "[hunt] SOLVED — both flags captured + accepted. tmux torn down. Run dir: $RUNDIR"
  elif rc2_both_flags "$RUNDIR"; then
    echo "[hunt] both flags present but NOT both accepted by the lab (captured-but-rejected/stale root?). Machine KEPT, state PRESERVED. Check logs/flag_submit.log; re-run: ./hunt $TARGET"
  else
    echo "[hunt] stopped (not both flags). State PRESERVED for resume (tmux + run dir kept). Re-run: ./hunt $TARGET"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
RUN_PID=""

# brain (doctrine) + launch prompt (both assembled in lib/run.sh)
SYSPROMPT="$(rc2_build_sysprompt)"
PROMPT="$(rc2_build_prompt)"

LOG="$RUNDIR/logs/session_$(date +%Y%m%d_%H%M%S).log"
# run metadata for report.sh / oversee.sh (model + start time)
printf 'model="%s"\nstart_epoch=%s\n' "$MODEL" "$(date +%s)" > "$RUNDIR/logs/meta.env"
CONV="$RUNDIR/logs/conv.jsonl"; : > "$CONV"
printf '%s\n' "$SYSPROMPT" > "$RUNDIR/logs/system_prompt.txt"
jq -cn --arg sp "$SYSPROMPT" '{type:"input",subtype:"system_prompt",chars:($sp|length)}' >> "$CONV" 2>/dev/null || true
jq -cn --arg p "$PROMPT" --arg m "$MODEL" '{type:"input",subtype:"launch",model:$m,prompt:$p}' >> "$CONV" 2>/dev/null || true

printf '\n%s[redcat2]%s hunting %s (%s) — run dir: %s\n' "$c" "$n" "${machine_name:-$target_ip}" "$target_ip" "$RUNDIR"
printf '%s  live feed:  scripts/watch.sh %s   (reasoning + every tool call/result)\n  tmux:       tmux attach -t %s\n  memory:     %s/{worldmodel,hypotheses,journal}.md%s\n\n' "$d" "$(basename "$RUNDIR")" "$RC2_TMUX" "$RUNDIR" "$n"

cd "$RUNDIR"
rc2_run_loop      # resilient headless loop (auto-relaunch on crash/overflow); sets RUN_PID for cleanup
